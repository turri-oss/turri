{
  "name": "@turri-dev/cli",
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turri-oss/turri.git"
  },
  "homepage": "https://github.com/turri-oss/turri#readme",
  "bugs": "https://github.com/turri-oss/turri/issues",
  "description": "An agent that builds code from ***plain specifications, with harness-enforced review and conformance gates.",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "turri": "bin/turri.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "cultivate": "node bin/turri.mjs cultivate",
    "typecheck": "tsc --noEmit",
    "chat": "node bin/turri.mjs",
    "ask": "node bin/turri.mjs -p --no-session",
    "test": "vitest run",
    "test:package": "node scripts/package-check.mjs",
    "test:watch": "vitest",
    "link:core": "node scripts/link-core.mjs",
    "conform": "node bin/turri.mjs conform",
    "regenerate": "node bin/turri.mjs regenerate",
    "parse": "node bin/turri.mjs parse",
    "doctor": "node bin/turri.mjs doctor",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@turri-dev/core": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "assets",
    "bin",
    "dist",
    ".pi",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
