{
  // The published package: src/ compiled to dist/, file for file, so each file sits as deep as its source and finds
  // the CLI's assets and themes the same way. A release builds against the core's published declarations.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "customConditions": [],
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    // Types for a host that imports @turri-dev/cli/host.
    "declaration": true
  },
  "include": ["src"]
}
